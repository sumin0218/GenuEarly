# tools/content-gen 환경변수 예시.
#
# 이 파일에는 변수 '이름'만 둔다. 실제 값을 적지 않는다.
# 복사해서 .env 로 만들고 값을 채운다. .env 는 커밋되지 않는다 (../../.gitignore).
#
# 규칙: docs/security/secure-coding.md 1절

# --- ChatKHU ----------------------------------------------------------------

# API 키. 이 도구를 돌리는 사람의 로컬 .env 에만 둔다.
#
# 여기는 빌드 타임 도구다. 확장 프로그램 번들에도, 중계 서버(apps/proxy)에도
# 이 키를 넣지 않는다. 사용자 트래픽을 이 키로 대행하지 않는다 —
# ChatKHU 이용 대상이 교내 재학생이기 때문이다 (docs/ai-log/sources.md).
CHATKHU_API_KEY=

# API 기본 주소. ChatKHU API Gateway (OpenAI 호환).
CHATKHU_API_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# 사용할 모델 ID.
# 서식4에 '어떤 모델로 만들었는지'를 적어야 하므로 별칭이 아니라 고정된 ID를 쓴다.
# 목록은 GET {BASE_URL}/models/ 로 본다.
CHATKHU_MODEL=claude-sonnet-5-5

# 한 번의 호출을 기다리는 최대 시간(ms).
CHATKHU_TIMEOUT_MS=60000

# --- 출력 -------------------------------------------------------------------

# 생성된 후보를 받아 둘 경로. 사람이 여기서 고른 뒤 packages/content 에 넣는다.
# 생성 원문은 서식4의 증빙이므로 덮어쓰지 않고 날짜별로 쌓는다.
OUTPUT_DIR=./out

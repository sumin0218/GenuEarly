# apps/proxy 환경변수 예시.
#
# 이 파일에는 변수 '이름'만 둔다. 실제 값을 적지 않는다.
# 복사해서 .env 로 만들고 값을 채운다. .env 는 커밋되지 않는다 (../../.gitignore).
#
# 규칙: docs/security/secure-coding.md 1절

# --- Jev (TypeSafe) ----------------------------------------------------------

# API 키. 이 서버의 환경변수에만 둔다. 확장 프로그램에는 어떤 형태로도 넣지 않는다.
JEV_API_KEY=

# 모델 ID. 별칭(jev-latest)이 아니라 버전을 고정한다.
# 별칭은 새 릴리스가 나오면 옮겨 가고, 우리는 확신도 임계값을 특정 버전에 맞춰 두었다.
# 근거: docs/jev.md 6절
JEV_MODEL=jev-1.13.0

# API 기본 주소. 보통 바꿀 일이 없다.
JEV_API_BASE_URL=https://api.typesafe.ai

# 한 번의 Jev 호출을 기다리는 최대 시간(ms).
# 늦은 배지는 없는 배지다. 넘으면 ⚪ 판단 보류로 돌려준다.
# TODO: 실제 응답 시간을 측정한 뒤 값을 정한다 (docs/jev.md 6절)
JEV_TIMEOUT_MS=

# --- 서버 --------------------------------------------------------------------

PORT=

# 허용할 요청 출처. 우리 확장 프로그램만 허용한다. 와일드카드(*)를 쓰지 않는다.
# TODO: 확장 프로그램 ID 확인 — 크롬 웹스토어에 올리거나 키를 고정한 뒤에 정해진다.
#       형식: chrome-extension://<확장 프로그램 ID>
ALLOWED_ORIGINS=

# 요청 본문 크기 상한(바이트). Jev의 컨텍스트 한도와 비용이 걸려 있다.
MAX_REQUEST_BYTES=

# 우리 서버 자체의 레이트 리밋. 공개된 엔드포인트는 남도 부른다.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# 로그 수준. 기사 본문과 URL 전체는 어느 수준에서도 남기지 않는다.
LOG_LEVEL=

{
  // Cloudflare Workers 설정. https://developers.cloudflare.com/workers/wrangler/configuration/
  //
  // 이 파일에 키를 적지 않는다. 키는 secret 으로 넣는다:
  //   npx wrangler secret put JEV_API_KEY
  // 로컬 개발은 .dev.vars 를 쓴다 (커밋되지 않는다).
  "name": "genuearly-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",

  "observability": { "enabled": true },

  // 선언해 두면 wrangler 가 배포 전에 빠진 secret 을 알려 준다.
  "secrets": {
    "required": ["JEV_API_KEY"]
  },

  // 키가 아닌 설정값. 여기 들어간 것은 공개돼도 된다.
  "vars": {
    // ChatKHU API Gateway. docs/jev.md 6-1절
    "JEV_API_BASE_URL": "https://factchat-cloud.mindlogic.ai/v1/gateway",
    // 별칭이 아니라 버전을 고정해 보낸다. packages/shared/judgment-items.json 의 model 과 맞춘다.
    // 게이트웨이가 이 ID 를 받는 것은 2026-10-21 에 확인했다 (HTTP 200).
    // 다만 **응답의 model 필드는 항상 jev-latest 로 돌아온다.** 게이트웨이가 별칭으로
    // 정규화한다. 그래서 어느 버전이 실제로 답했는지는 확인할 수 없다 (docs/jev.md 6-1절).
    "JEV_MODEL": "jev-1.13.0",
    // Jev 한 번 호출을 기다리는 최대 시간(ms). 넘으면 판단 보류로 돌려준다.
    "JEV_TIMEOUT_MS": "8000",
    // 요청 본문 크기 상한(바이트).
    "MAX_REQUEST_BYTES": "65536",
    // 크레딧 예비분. 남은 크레딧이 이 아래로 내려가면 판단을 멈추고 ⚪ 로 돌린다.
    // 월 할당 4,000 이고 호출당 약 0.081 이라 500 은 약 6,000 건이다 — 심사·시연에 쓸 몫이다.
    // 0 으로 두면 감시를 끈다.
    "CREDITS_RESERVE": "500",
    // 잔액을 다시 묻는 간격. 이 사이에 한도껏 지나가도 약 10 크레딧이라 예비분에 비해 작다.
    "CREDITS_TTL_MS": "60000",
    "CREDITS_TIMEOUT_MS": "3000"
  }
}
